 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 911920806, "version": 2, "versionNonce": 987974664, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c09r", "text": "• Aura Sensor (Xiaomi Band) = único hardware real en la demo\n• Si Web Bluetooth falla, pulso simulado (misma curva)\n• Sábana = modelo simple: se acerca al objetivo 0,1 °C/s\n• Fase de sueño se infiere del pulso (aprox. para demo)", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Aura Sensor (Xiaomi Band) = único hardware real en la demo\n• Si Web Bluetooth falla, pulso simulado (misma curva)\n• Sábana = modelo simple: se acerca al objetivo 0,1 °C/s\n• Fase de sueño se infiere del pulso (aprox. para demo)", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00612", "type": "text", "x": 1500, "y": 4550, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 547683752, "version": 2, "versionNonce": 1200302036, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c09s", "text": "D2 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "D2 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00613", "type": "text", "x": 1500, "y": 4582, "width": 382.2, "height": 75.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness":