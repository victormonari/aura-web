ontainerId": null, "originalText": "• Plan de 3 fases editable\n• Automático por defecto\n• Rango 13–43 °C (Fig. 6)", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00470", "type": "text", "x": 1486, "y": 2730, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2137660698, "version": 2, "versionNonce": 450945362, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c07a", "text": "H4 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "H4 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00471", "type": "text", "x": 1486, "y": 2762, "width": 304.2, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1155760847, "version": 2, "versionNonce": 1049121818, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c07b", "text": "• Consejos que se APLICAN, no se envían\n• Cada uno explica el porqué\n• Cambian sábana o turnos al instante", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Consejos que se APLICAN, no se envían\n• Cada uno explica el porqué\n• Cambian sábana o turnos al instante", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00472", "type": "text", "x": 1976, "y": 2730, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": nul