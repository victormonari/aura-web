nt", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1769453685, "version": 2, "versionNonce": 1930143543, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02r", "text": "C1 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "C1 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00178", "type": "text", "x": 16, "y": 1572, "width": 280.8, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 785936594, "version": 2, "versionNonce": 995695073, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02s", "text": "• Lo hace con el hijo/a al lado\n• 2 preguntas, respuestas en botones\n• Nada de \"emparejar\" ni Wi-Fi", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Lo hace con el hijo/a al lado\n• 2 preguntas, respuestas en botones\n• Nada de \"emparejar\" ni Wi-Fi", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00179", "type": "text", "x": 506, "y": 1540, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 119584257, "version": 2, "versionNonce": 1476989857, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02t", "text": "C2 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "C2 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00180", "type": "text", "x": 506, "y": 1572, "width": 241.8, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 355790301, "version": 2, "versionNonce": 1332973056, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02u", "text": "• Solo 3 botones, enormes\n• Saludo por su nombre\n• Estado de la cama en palabras", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Solo 3 botones, enormes\n• Saludo por su nombre\n• Estado de la cama en palabras", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00181", "type": "text", "x": 996, "y": 1540, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 109635986, "version": 2, "versionNonce": 1562264727, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02v", "text": "C3 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "C3 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00182", "type": "text", "x": 996, "y": 1572, "width": 273.0, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1512008797, "version": 2, "versionNonce": 1280121397, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02w", "text": "• Fondo oscuro cálido, sin luz azul\n• Sábana enfría sola (inducción)\n• Sonido con apagado automático", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Fondo oscuro cálido, sin luz azul\n• Sábana enfría sola (inducción)\n• Sonido con apagado automático", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00183", "type": "text", "x": 1486, "y": 1540, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1336717925, "version": 2, "versionNonce": 1053114059, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02x", "text": "C4 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "C4 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00184", "type": "text", "x": 1486, "y": 1572, "width": 257.40000000000003, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 588492175, "version": 2, "versionNonce": 1322285448, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02y", "text": "• 4 sonidos, un toque y suena\n• Temporizador por defecto 30 min\n• Sonidos generados (Web Audio)", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• 4 sonidos, un toque y suena\n• Temporizador por defecto 30 min\n• Sonidos generados (Web Audio)", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00185", "type": "text", "x": 1976, "y": 1540, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 960915368, "version": 2, "versionNonce": 2104821860, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02z", "text": "C5 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "C5 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00186", "type": "text", "x": 1976, "y": 1572, "width": 288.6, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 484658296, "version": 2, "versionNonce": 505563643, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c030", "text": "• Opcional, TCC-I mínima\n• Sin texto que leer mientras respira\n• 1 minuto y termina solo", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Opcional, TCC-I mínima\n• Sin texto que leer mientras respira\n• 1 minuto y termina solo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00187", "type": "text", "x": 2466, "y": 1540, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 656363255, "version": 2, "versionNonce": 1456480621, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c031", "text": "C6 nuevo", "fontSize": 18, "fon