: 1792561155081, "link": null, "locked": false, "index": "c07U", "text": "H1 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "H1 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00465", "type": "text", "x": 16, "y": 2762, "width": 273.0, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1326387936, "version": 2, "versionNonce": 1200026140, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c07V", "text": "• Alerta arriba, con acción directa\n• 4 números clave con meta al lado\n• Barras de 7 días, línea de 85 %", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Alerta arriba, con acción directa\n• 4 números clave con meta al lado\n• Barras de 7 días, línea de 85 %", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00466", "type": "text", "x": 506, "y": 2730, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1351827532, "version": 2, "versionNonce": 1570457140, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c07W", "text": "H2 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "H2 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00467", "type": "text", "x": 506, "y": 2762, "width": 288.6, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1