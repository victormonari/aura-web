l, "originalText": "C2 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00180", "type": "text", "x": 506, "y": 1572, "width": 241.8, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1107563897, "version": 2, "versionNonce": 899139943, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02u", "text": "• Solo 3 botones, enormes\n• Saludo por su nombre\n• Estado de la cama en palabras", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Solo 3 botones, enormes\n• Saludo por su nombre\n• Estado de la cama en palabras", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00181", "type": "text", "x": 996, "y": 1540, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 30365247, "version": 2, "versionNonce": 165919426, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02v", "text": "C3 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "C3 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00182", "type": "text", "x": 996, "y": 1572, "width": 273.0, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1113084259, "version": 2, "versionNonce": 113160184, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02w", "text": "• Fondo oscuro cálido, sin luz azul\n• Sábana enfría sola (inducción)\n• Sonido con apagado automático", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• Fondo oscuro cálido, sin luz azul\n• Sábana enfría sola (inducción)\n• Sonido con apagado automático", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00183", "type": "text", "x": 1486, "y": 1540, "width": 74.88, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 819911958, "version": 2, "versionNonce": 1037763799, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02x", "text": "C4 nuevo", "fontSize": 18, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "C4 nuevo", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00184", "type": "text", "x": 1486, "y": 1572, "width": 257.40000000000003, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 730323482, "version": 2, "versionNonce": 478886173, "isDeleted": false, "boundElements": [], "updated": 1792561155081, "link": null, "locked": false, "index": "c02y", "text": "• 4 sonidos, un toque y suena\n• Temporizador por defecto 30 min\n• Sonidos generados (Web Audio)", "fontSize": 15, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "• 4 sonidos, un toque y suena\n• Temporizador por defecto 30 min\n• Sonidos generados (Web Audio)", "autoResize": true, "lineHeight": 1.25}, {"id": "aura_00185", "type": 